# Nginx example for the vrdata receiver. Copy to
# /etc/nginx/conf.d/vrdata.conf, replace example.invalid, then
# `nginx -t && systemctl reload nginx`.
#
# The receiver binds 127.0.0.1:8197 and never listens on a public socket, so
# this file is the only way in. It publishes the upload contract and, when the
# operator password is configured, the password-gated read console. Every other
# path under /vrdata/ is refused here as well as in the app, so an operator who
# later adds a route in Python still cannot expose it by accident.
#
# The console requires the operator password. Nginx does not know it and must
# not: the receiver does the check, and these routes pass through untouched.

upstream vrdata_receiver {
    server 127.0.0.1:8197;
    keepalive 8;
}

# Body size matches the receiver's own 1 MiB cap; nginx rejects with 413 before
# the request reaches Python.
server {
    listen 443 ssl;
    http2 on;
    server_name vrdata.example.invalid;

    # TLS: fill in real paths (certbot writes them here).
    ssl_certificate     /etc/letsencrypt/live/vrdata.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vrdata.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:vrdata_tls:1m;
    ssl_session_timeout 1h;

    # No version banner, no directory index, no request echo.
    server_tokens off;
    autoindex off;
    access_log /var/log/nginx/vrdata.access.log;
    error_log  /var/log/nginx/vrdata.error.log warn;

    client_max_body_size 1m;
    client_body_timeout 20s;
    keepalive_timeout 30s;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /vrdata/health {
        limit_except GET { deny all; }
        proxy_pass http://vrdata_receiver;
        include /etc/nginx/proxy_params;
        # Health is status only; keep it out of caches.
        proxy_buffering off;
    }

    location = /vrdata/ {
        limit_except POST { deny all; }
        proxy_pass http://vrdata_receiver;
        include /etc/nginx/proxy_params;
        # The receiver requires Content-Length and refuses chunked bodies.
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # The read console: one page plus its JSON API, both gated by the operator
    # password inside the receiver. `X-Forwarded-Proto` is what lets the service
    # mark the session cookie `Secure` even though it speaks plain HTTP on the
    # loopback socket behind this terminator.
    location = /vrdata/admin/ {
        proxy_pass http://vrdata_receiver;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        # Session JSON is small; never let a cache hold it.
        proxy_ignore_headers Cache-Control;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }

    location /vrdata/admin/ {
        proxy_pass http://vrdata_receiver;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_read_timeout 30s;
        proxy_ignore_headers Cache-Control;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }

    # Everything else: 404, not 403 — do not confirm what exists.
    location /vrdata/ {
        return 404;
    }

    location / {
        return 404;
    }
}

# Plain HTTP only redirects, so a sender that guesses http:// is not silently
# posting patient records in the clear.
server {
    listen 80;
    server_name vrdata.example.invalid;
    server_tokens off;
    location / {
        return 308 https://$host$request_uri;
    }
}
