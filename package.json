  "dependencies": {
    "three": "0.152.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/three": "0.152.1",
    "@types/webxr": "0.5.20",
    "esbuild": "0.25.0",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
