{
  "name": "quiet-shore-vr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "静岸 · Quiet Shore VR — WebXR training app for PICO G2 4K",
  "scripts": {
    "dev": "node build.mjs --serve",
    "build": "node build.mjs",
